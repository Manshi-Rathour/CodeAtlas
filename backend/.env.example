# PostgreSQL connection string used by the FastAPI backend
DATABASE_URL=postgresql://your-codeatlas-db:choose-a-local-password@localhost:5432/your-codeatlas-db-user

# Authentication
SECRET_KEY=replace-with-a-long-random-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Uploaded and extracted projects (relative to the backend directory)
UPLOAD_DIR=app/storage/projects
MAX_UPLOAD_SIZE_MB=100

# Local Ollama server and model
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5-coder:7b
